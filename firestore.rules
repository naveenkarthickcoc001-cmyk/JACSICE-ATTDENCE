rules_version = '2';

// ====================================================================
// SMART ATTENDANCE SYSTEM -- FIRESTORE SECURITY RULES
// Paste this into Firebase Console -> Firestore Database -> Rules
// OR deploy with:  firebase deploy --only firestore:rules
// ====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper functions ------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Fetch the caller's profile from users collection
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function isAdmin()   { return isSignedIn() && role() == 'admin';   }
    function isTeacher() { return isSignedIn() && role() == 'teacher'; }
    function isStudent() { return isSignedIn() && role() == 'student'; }
    function isStaff()   { return isSignedIn() && role() == 'staff';   }

    function isAdminOrTeacher() { return isAdmin() || isTeacher(); }
    function isAdminOrStaff()   { return isAdmin() || isStaff();   }
    function isPrivileged()     { return isAdmin() || isTeacher() || isStaff(); }

    // -- /users/{userId} ------------------------------------------
    // Mirrors: user_directory table
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && uid() == userId;
      allow update: if uid() == userId || isAdmin();
      allow delete: if isAdmin();
    }

    // -- /pending/{docId} -----------------------------------------
    // Registration requests waiting for admin approval
    match /pending/{docId} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -- /departments/{deptId} ------------------------------------
    match /departments/{deptId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // -- /subjects/{subjectId} ------------------------------------
    match /subjects/{subjectId} {
      allow read:  if true;
      allow write: if isAdminOrTeacher();
    }

    // -- /attendance_logs/{logId} ---------------------------------
    // Daily per-student attendance records
    match /attendance_logs/{logId} {
      allow read:   if isSignedIn();
      allow create: if isPrivileged();
      allow update: if isPrivileged();
      allow delete: if isAdmin();
    }

    // -- /att_summary/{studentId} ---------------------------------
    // Aggregated attendance stats per student
    match /att_summary/{studentId} {
      allow read:  if isSignedIn() &&
                      (uid() == studentId || isPrivileged());
      allow write: if isPrivileged();
    }

    // -- /marks/{markId} -----------------------------------------
    match /marks/{markId} {
      allow read:   if isSignedIn() &&
                       (resource.data.studentId == uid() || isAdminOrTeacher());
      allow create: if isAdminOrTeacher();
      allow update: if isAdminOrTeacher();
      allow delete: if isAdmin();
    }

    // -- /timetable/{entryId} ------------------------------------
    match /timetable/{entryId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrTeacher();
    }

    // -- /master_periods/{periodId} ------------------------------
    match /master_periods/{periodId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
